      <mass value="1.0"/>
      <inertia ixx="7.625283" ixy="0.0" ixz="0.0" iyy="6.927748" iyz="0.0" izz="2.432560"/>
    </inertial>
  </link>

  <!-- Joint connecting CASE_2 to CASE_3 -->
  <joint name="CASE_3_joint" type="revolute">
    <parent link="CASE_2"/>
    <child link="CASE_3"/>
    <origin xyz="3.816296 -0.124469 -3.085722" rpy="-3.141593 0.000000 -0.000385"/>
