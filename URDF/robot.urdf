      <mass value="1.0"/>
      <inertia ixx="2.586780" ixy="0.0" ixz="0.0" iyy="2.028938" iyz="0.0" izz="2.289770"/>
    </inertial>
  </link>

  <!-- Joint connecting CASE_1 to CASE_2 -->
  <joint name="CASE_2_joint" type="revolute">
    <parent link="CASE_1"/>
    <child link="CASE_2"/>
    <origin xyz="-0.035675 0.075565 4.329944" rpy="1.570796 -1.570796 0.000000"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1.0"/>
  </joint>

  <!-- CASE_3 Link -->
