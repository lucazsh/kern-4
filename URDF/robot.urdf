<?xml version="1.0"?>
<robot name="robot_arm">

  <!-- World Link (fixed base) -->
  <link name="world"/>

  <!-- CASE_1 Link -->
  <link name="CASE_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/CASE_1.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/CASE_1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="2.491326" ixy="0.0" ixz="0.0" iyy="2.491326" iyz="0.0" izz="2.207713"/>
    </inertial>
  </link>

  <!-- Joint connecting world to CASE_1 -->
  <joint name="CASE_1_joint" type="fixed">
    <parent link="world"/>
    <child link="CASE_1"/>
    <origin xyz="0.027805 1.532023 1.825173" rpy="-0.000000 -0.000000 0.000000"/>
  </joint>

  <!-- CASE_2 Link -->
  <link name="CASE_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
